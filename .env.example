# Copy this file to .env and update the values as needed.
# Secrets
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
GEMINI_API_KEY=

# Run mode
BOT_MODE=polling
WEBHOOK_HOST=https://your.domain
WEBHOOK_PATH=/tg/webhook
TELEGRAM_SECRET_TOKEN=change_me_32c
HOST=0.0.0.0
PORT=8080

# Provider configuration
GEMINI_API_VERSION=v1
GEMINI_MODEL_TEXT=gemini-2.0-flash
GEMINI_MODEL_IMAGE=gemini-2.5-flash-image
GEMINI_MODEL_VIDEO=veo-3.0-generate-001
SORA_API_KEY=
OPENAI_API_KEY=
OPENAI_ORG_ID=
SORA_MODEL_VIDEO=sora
OPENAI_API_BASE=https://api.openai.com
OPENAI_API_VERSION_VIDEO=
OPENAI_BETA_HEADER=

# Persistence
DATABASE_PATH=./bot.db

# Google Sheets storage
GOOGLE_SHEET_ID=
GOOGLE_SA_JSON_BASE64=
GS_USERS_SHEET=users
GS_PAYMENTS_SHEET=payments
GS_JOBS_SHEET=jobs

# Job processing limits
JOBS_CONCURRENCY=2
MAX_JOBS_PER_USER=3

# Credits and pricing
CREDITS_PER_PAYMENT=10
CREDITS_PER_GENERATION=1

# HTTP client behaviour
REQUEST_TIMEOUT=30.0
PROVIDER_TIMEOUT_S=60.0
REQUEST_RETRIES=3
RETRY_BACKOFF=2.0

# Optional integrations
AIROGRAM_REDIS_URL=

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST_MODE=true
PUBLIC_BASE_URL=https://your.domain
YOOKASSA_RETURN_PATH=/pay/return
YOOKASSA_WEBHOOK_PATH=/pay/webhook
YOOKASSA_SEND_RECEIPTS=false
YOOKASSA_POLL_INTERVAL=60

# Pricing (RUB)
PRICE_ONE_RUB=119
PRICE_FIVE_RUB=595
PRICE_TEN_RUB=1190
PRICE_THIRTY_RUB=3570

# Optional subscription bonus
SUBSCRIPTION_CHAT_ID=
