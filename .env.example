# Copy this file to .env and update the values as needed.
# Secrets
BOT_TOKEN=your-telegram-bot-token
SORA_API_KEY=your-sora-api-key

# Sora API configuration
SORA_API_URL=https://api.sora.ai/v1

# Persistence
DATABASE_PATH=./bot.db

# Job processing limits
JOBS_CONCURRENCY=2
MAX_JOBS_PER_USER=3

# Credits and pricing
CREDITS_PER_PAYMENT=10
CREDITS_PER_GENERATION=1

# HTTP client behaviour
REQUEST_TIMEOUT=30.0
REQUEST_RETRIES=3
RETRY_BACKOFF=2.0

# Optional integrations
AIROGRAM_REDIS_URL=
