modules = ["python-3.11"]

run = "python main.py"

[deployment]
run = "python main.py"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 43015
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "telegram-bot"

[[workflows.workflow]]
name = "telegram-bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[agent]
expertMode = true
